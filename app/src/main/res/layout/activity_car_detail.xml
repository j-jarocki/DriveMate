<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText android:id="@+id/carNameEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/car_name_hint" />

        <EditText android:id="@+id/carMileageEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mileage_hint"
            android:inputType="numberDecimal" />

        <EditText android:id="@+id/oilChangeMileageEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/oil_mileage_hint"
            android:inputType="numberDecimal" />

        <EditText android:id="@+id/oilIntervalEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/oil_interval_hint"
            android:inputType="number" />

        <EditText android:id="@+id/inspectionIntervalEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/inspection_interval_hint"
            android:inputType="number" />

        <Button android:id="@+id/lastInspectionBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_inspection_date" />

        <Button android:id="@+id/updateOilBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/change_oil_now" />

        <Button android:id="@+id/updateInspectionBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/do_inspection_now" />

        <Button android:id="@+id/saveCarBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_car"
            android:backgroundTint="#4CAF50"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>